# Copy to .env, fill the secrets, then set file permissions: chmod 600 .env

# Public hostname users enter in a browser or Bitwarden app, without "https://".
# Source: choose a subdomain in a DNS zone managed by Cloudflare, such as vault.example.com.
# It must exactly match the Public Hostname configured for the Cloudflare Tunnel.
VAULTWARDEN_DOMAIN=vault.example.com

# Break-glass fallback Argon2id PHC hash protecting Vaultwarden's /admin page. Do not store the
# plaintext admin password here. Generate a hash with:
# `docker run --rm -it vaultwarden/server:latest /vaultwarden hash`
# Enter the plaintext only when prompted and store the returned `$argon2id$...` value here.
# Normally, `bin/vaultwarden-compose` gets this same hash from Bitwarden CLI instead.
ADMIN_TOKEN='$argon2id$v=19$m=65536,t=3,p=4$replace-with-salt$replace-with-hash'
# Whether anyone can create an account from the public registration page.
# Source: choose false unless deliberately opening a brief registration period.
SIGNUPS_ALLOWED=false
# Whether existing users/admins may invite other users.
# Source: choose based on whether this is an individual or shared deployment.
INVITATIONS_ALLOWED=true

# Break-glass fallback credential for this connector to join a remotely-managed Cloudflare Tunnel.
# Source: Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> token. Normally,
# the `bin/vaultwarden-compose` launcher gets this from Bitwarden CLI instead.
# Configure the tunnel Public Hostname to send HTTP traffic to `http://vaultwarden:80`.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Complete destination used by rclone sync, including remote name and optional path.
# Source: create and test a remote using `rclone config`; when the crypt remote
# already points at the bucket (remote = r2:vaultwarden-backups), use just `crypt:`.
# Until this is filled in, backup-sync refuses to run and reports unhealthy.
RCLONE_REMOTE=replace-with-rclone-remote-and-path
# Host DIRECTORY containing rclone.conf, mounted read-only into the sync container.
# Must be the directory, not the rclone.conf file itself; use an absolute path
# (compose does not expand ~) or the default ./rclone directory.
RCLONE_CONFIG_HOST=./rclone

# How long archives overwritten or deleted by local retention are kept in the
# remote previous/ directory before pruning. Default: 30d.
RCLONE_BACKUP_DIR_RETENTION=30d

# Number of change-triggered archives kept locally. Default: 15.
BACKUP_WATCH_RETENTION=15
# Seconds without another SQLite database change before a watch backup runs. Default: 300.
BACKUP_WATCH_DEBOUNCE=300
# Minimum seconds between two watch backups. Built-in default: 3600 (one per hour).
# Logged-in Bitwarden clients refresh their access tokens roughly hourly, and each
# refresh writes to the database; raise this so token churn does not create backups.
BACKUP_WATCH_MIN_INTERVAL=21600
# Number of scheduled archives kept locally. Default: 5.
BACKUP_SCHEDULED_RETENTION=5
# Cron expression for scheduled local backups. Default: 02:00 every Sunday.
# Source: choose any five-field cron schedule in the container's timezone (UTC by default).
BACKUP_SCHEDULE=0 2 * * 0
# Cron expression for rclone synchronization. Default: every 10 minutes.
# Source: choose any five-field cron schedule; avoid syncing more frequently than needed.
BACKUP_SYNC_SCHEDULE=*/10 * * * *
# A backup-scheduled container turns unhealthy once its last success marker is
# older than this many days. Default: 8 (weekly schedule plus one day of slack).
BACKUP_SCHEDULED_HEALTHCHECK_DAYS=8
# A backup-sync container turns unhealthy once its last success marker is older
# than this many minutes. Default: 30 (sync schedule plus slack).
BACKUP_SYNC_HEALTHCHECK_MINUTES=30
