# Runtime configuration and secrets. Keep .env.example tracked as a template.
.env
.env.*
!.env.example
/.secrets.env

# Vaultwarden data, local archives, backup logs, and rclone credentials.
data/
backups/
logs/
rclone/

# TLS material and Cloudflare credential files, if added later.
*.pem
*.key
*.crt
*.json
!compose*.json

# Local development metadata.
.idea/
.DS_Store
*.log
